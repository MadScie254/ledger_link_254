# Public values baked into the browser bundle by `vite build`, used by
# Cloudflare Workers Builds when it deploys main. Both are already served to
# every visitor in the app's JavaScript: the project URL and the publishable
# key are meant to be public. Never put a secret here: SUPABASE_SECRET_KEY and
# GEMINI_API_KEY are Worker secrets (`wrangler secret put`), not build values.
# Variables already set in the environment (CI, the e2e runner) take priority.
VITE_SUPABASE_URL=https://jhmlkcuqsmynnkqgfisf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QB_JnzKjh5e82TotTXlVLg_tuJ5g9fC
