{
  "name": "ledgerlink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test src/utils/*.test.ts src/components/onboarding/*.test.ts src/components/documentation/*.test.ts",
    "test:db": "bash tests/db/run.sh",
    "test:integration": "bash tests/integration/run.sh",
    "test:e2e": "bash tests/e2e/run.sh",
    "seed:demo-law": "esbuild scripts/seed-demo-law.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.seed/seed-demo-law.mjs && node .seed/seed-demo-law.mjs",
    "seed:demo-church": "esbuild scripts/seed-demo-church.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.seed/seed-demo-church.mjs && node .seed/seed-demo-church.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.102.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hono": "^4.13.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "papaparse": "^5.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "playwright-core": "1.56",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
