# LedgerLink — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API

# Server-side (Express, src/server/supabase.ts) — read via process.env.
# Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser; RLS enforces access control)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — BACKEND ONLY. Never send this to the client or commit it.
# Used by the Express server to bypass RLS for trusted server-side operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-side (Vite, src/lib/supabase.ts) — must be VITE_-prefixed or Vite
# will NOT expose them to browser code, and the frontend Supabase client will
# silently get empty strings. Use the SAME project URL and anon key as above.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Never expose this key to the browser.
# Used for the receipt scanner endpoint (POST /api/expenses/scan).
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Application ─────────────────────────────────────────────────────────────
# Port for the Express server
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Comma-separated browser origins permitted by CORS. In development, include
# the exact origin (protocol + host + port) your browser uses to reach this
# server. If PORT below is not 3001, update this line to match — a mismatch
# here is the #1 cause of "CORS: origin not allowed" errors in dev.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to true in dev/staging to seed demo organizations (Acme Corp, Apex Holdings).
# MUST be false (or unset) in production.
ENABLE_SEED_DATA=false
