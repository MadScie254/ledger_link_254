# LedgerLink — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API

# Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser; RLS enforces access control)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — BACKEND ONLY. Never send this to the client or commit it.
# Used by the Express server to bypass RLS for trusted server-side operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Never expose this key to the browser.
# Used for the receipt scanner endpoint (POST /api/expenses/scan).
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Application ─────────────────────────────────────────────────────────────
# Port for the Express server
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Frontend origin for CORS (used in production; in dev Vite proxy handles it)
FRONTEND_ORIGIN=http://localhost:5173

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to true in dev/staging to seed demo organizations (Acme Corp, Apex Holdings).
# MUST be false (or unset) in production.
ENABLE_SEED_DATA=false
